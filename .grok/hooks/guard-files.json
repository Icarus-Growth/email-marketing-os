{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "search_replace|write_file|run_terminal_command|Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/shared/scripts/agent-hooks/guard-files.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && python3 tools/sync_skills.py >/dev/null 2>&1 || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
