# Copy this file to .env and fill in the values. Never commit .env. Never paste these into a chat.
# Write each line as NAME=value: no space before or after "=", and no quotes.

# --- Tab 1: database (Supabase) ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=
# The publishable key goes in two places: here, and in the agency-os Modal secret (tab 3, Step 7.5).
# The AI connector's db.read and db.write use it, so each person's AI works with their own access.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# --- Tab 2: the OS and the onboarding form (Cloudflare, Porkbun) ---
# A Cloudflare API token (tab 2, Step 2): Cloudflare Pages Edit, DNS Edit, Zone Read.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Only if you use the Global API Key instead of a token. A token is used whenever one is set.
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
# Optional, same as --domain. Leave empty if you follow the tabs.
OS_DOMAIN=
# Optional. The Cloudflare Pages project name. Default: agency-os
OS_PROJECT=
# Optional, same as --domain. Leave empty if you follow the tabs.
ONBOARDING_DOMAIN=
# Optional. The Cloudflare Pages project name of the form. Default: onboarding-form
ONBOARDING_PROJECT=

# --- Tab 3: automations (Slack, Modal, logo.dev) ---
# The automations app reads its keys from one Modal secret named agency-os (tab 3, Step 7.5):
# SLACK_BOT_TOKEN, SUPABASE_URL, SUPABASE_SECRET_KEY, SUPABASE_PUBLISHABLE_KEY, OS_SHARED_SECRET,
# SLACK_ICON_URL and MCP_TOKEN_PEPPER. After you change one of them here, store the secret again and deploy.
SLACK_BOT_TOKEN=
SLACK_ICON_URL=
LOGO_DEV_PUBLISHABLE_KEY=
OS_AUTOMATIONS_URL=
OS_SHARED_SECRET=
# Scrambles the AI connector keys. Made by connect_db.py secret. Never change it once set.
MCP_TOKEN_PEPPER=
