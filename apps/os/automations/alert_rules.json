{
  "_about": "One rule list for every board. When a card is added or moves, the first rule that matches decides the channel (a key in channels.json), the bot name and emoji, who is tagged (the first one filled in: assignee, reviewer, owner, or client.<role column>) and the one thing they must do. 'thread' puts that column of the card in a thread reply. No rule, no post. A stage name here must be spelled exactly as in the database.",
  "boards": {
    "tasks": {
      "label": "Tasks",
      "final": [
        "100 - Complete",
        "-1 - Rejected"
      ]
    },
    "flows": {
      "label": "Flows",
      "final": [
        "60 - Live"
      ]
    },
    "campaign_calendars": {
      "label": "Campaigns",
      "final": [
        "60 - Scheduled",
        "100 - Done"
      ]
    }
  },
  "client_roles": [
    "account_manager_id",
    "copywriter_id",
    "designer_id",
    "builder_id"
  ],
  "rules": [
    {
      "board": "*",
      "when": "new",
      "channel": "new-tasks",
      "bot_name": "New Card",
      "emoji": "🆕",
      "tag": [
        "assignee",
        "client.account_manager_id",
        "owner"
      ],
      "action": "Check the card, then give it a person and a due date if it has none."
    },
    {
      "board": "tasks",
      "to": [
        "9 - Blocked"
      ],
      "channel": "task-updates",
      "bot_name": "Task Blocked",
      "emoji": "🧱",
      "tag": [
        "client.account_manager_id",
        "owner"
      ],
      "action": "Help unblock this task. The notes on the card say what is in the way.",
      "thread": "notes"
    },
    {
      "board": "tasks",
      "to": [
        "-1 - Rejected"
      ],
      "channel": "task-updates",
      "bot_name": "Task Rejected",
      "emoji": "🚫",
      "tag": [
        "assignee"
      ],
      "action": "This task will not be done. Stop work on it.",
      "thread": "notes"
    },
    {
      "board": "tasks",
      "to": [
        "29 - Amendments"
      ],
      "channel": "amendments",
      "bot_name": "Needs Amendments",
      "emoji": "✏️",
      "tag": [
        "assignee"
      ],
      "action": "Make the changes, then move the card back to review.",
      "thread": "notes"
    },
    {
      "board": "tasks",
      "to": [
        "30 - In Review"
      ],
      "channel": "review",
      "bot_name": "Ready For Review",
      "emoji": "👀",
      "tag": [
        "reviewer",
        "client.account_manager_id",
        "owner"
      ],
      "action": "Check the work, then move it to Complete or send it back."
    },
    {
      "board": "tasks",
      "to": [
        "100 - Complete"
      ],
      "channel": "approved",
      "bot_name": "Task Complete",
      "emoji": "🙌",
      "tag": [
        "assignee"
      ],
      "action": "Nothing more to do. Well done."
    },
    {
      "board": "flows",
      "to": [
        "10 - Brief In Progress"
      ],
      "channel": "task-updates",
      "bot_name": "Brief To Write",
      "emoji": "📝",
      "tag": [
        "assignee",
        "client.account_manager_id"
      ],
      "action": "Write the brief, then move the card to Copy."
    },
    {
      "board": "flows",
      "to": [
        "19 - Brief Amendments"
      ],
      "channel": "amendments",
      "bot_name": "Brief Amendments",
      "emoji": "✏️",
      "tag": [
        "assignee",
        "client.account_manager_id"
      ],
      "action": "Make the changes, then move the card on.",
      "thread": "feedback_notes"
    },
    {
      "board": "flows",
      "to": [
        "20 - Copy"
      ],
      "channel": "task-updates",
      "bot_name": "Ready For Copy",
      "emoji": "✍️",
      "tag": [
        "assignee",
        "client.copywriter_id"
      ],
      "action": "Write the copy for every email, then move the card to Design."
    },
    {
      "board": "flows",
      "to": [
        "30 - Design"
      ],
      "channel": "task-updates",
      "bot_name": "Ready For Design",
      "emoji": "🎨",
      "tag": [
        "assignee",
        "client.designer_id"
      ],
      "action": "Design every email, then move the card to Design QA."
    },
    {
      "board": "flows",
      "to": [
        "39 - Design Amendments"
      ],
      "channel": "amendments",
      "bot_name": "Design Amendments",
      "emoji": "🖌️",
      "tag": [
        "assignee",
        "client.designer_id"
      ],
      "action": "Fix the designs, then move the card back to Design QA.",
      "thread": "feedback_notes"
    },
    {
      "board": "flows",
      "to": [
        "40 - Design QA"
      ],
      "channel": "review",
      "bot_name": "Ready For Design QA",
      "emoji": "👀",
      "tag": [
        "reviewer",
        "client.account_manager_id",
        "owner"
      ],
      "action": "Check the designs, then move the card on or send it back."
    },
    {
      "board": "flows",
      "to": [
        "50 - Build In Email Platform"
      ],
      "channel": "task-updates",
      "bot_name": "Ready To Build",
      "emoji": "🛠️",
      "tag": [
        "assignee",
        "client.builder_id"
      ],
      "action": "Build the emails in the email platform, then move the card on."
    },
    {
      "board": "campaign_calendars",
      "to": [
        "10 - Calendar In Progress"
      ],
      "channel": "task-updates",
      "bot_name": "Calendar To Plan",
      "emoji": "📝",
      "tag": [
        "assignee",
        "client.account_manager_id"
      ],
      "action": "Plan the month's campaigns, then move the card to Copy."
    },
    {
      "board": "campaign_calendars",
      "to": [
        "19 - Calendar Amendments"
      ],
      "channel": "amendments",
      "bot_name": "Calendar Amendments",
      "emoji": "✏️",
      "tag": [
        "assignee",
        "client.account_manager_id"
      ],
      "action": "Make the changes, then move the card on.",
      "thread": "feedback_notes"
    },
    {
      "board": "campaign_calendars",
      "to": [
        "20 - Copy"
      ],
      "channel": "task-updates",
      "bot_name": "Ready For Copy",
      "emoji": "✍️",
      "tag": [
        "assignee",
        "client.copywriter_id"
      ],
      "action": "Write the copy for every email, then move the card to Design."
    },
    {
      "board": "campaign_calendars",
      "to": [
        "30 - Design"
      ],
      "channel": "task-updates",
      "bot_name": "Ready For Design",
      "emoji": "🎨",
      "tag": [
        "assignee",
        "client.designer_id"
      ],
      "action": "Design every email, then move the card to Design QA."
    },
    {
      "board": "campaign_calendars",
      "to": [
        "39 - Design Amendments"
      ],
      "channel": "amendments",
      "bot_name": "Design Amendments",
      "emoji": "🖌️",
      "tag": [
        "assignee",
        "client.designer_id"
      ],
      "action": "Fix the designs, then move the card back to Design QA.",
      "thread": "feedback_notes"
    },
    {
      "board": "campaign_calendars",
      "to": [
        "40 - Design QA"
      ],
      "channel": "review",
      "bot_name": "Ready For Design QA",
      "emoji": "👀",
      "tag": [
        "reviewer",
        "client.account_manager_id",
        "owner"
      ],
      "action": "Check the designs, then move the card on or send it back."
    },
    {
      "board": "campaign_calendars",
      "to": [
        "50 - Build In Email Platform"
      ],
      "channel": "task-updates",
      "bot_name": "Ready To Build",
      "emoji": "🛠️",
      "tag": [
        "assignee",
        "client.builder_id"
      ],
      "action": "Build the emails in the email platform, then move the card on."
    },
    {
      "board": "flows",
      "to": [
        "60 - Live"
      ],
      "channel": "approved",
      "bot_name": "Flow Live",
      "emoji": "🙌",
      "tag": [
        "client.account_manager_id",
        "client.builder_id"
      ],
      "action": "Tell the client the flow is live."
    },
    {
      "board": "campaign_calendars",
      "to": [
        "60 - Scheduled"
      ],
      "channel": "approved",
      "bot_name": "Campaigns Scheduled",
      "emoji": "📅",
      "tag": [
        "client.account_manager_id",
        "client.builder_id"
      ],
      "action": "Tell the client the month's campaigns are scheduled."
    },
    {
      "board": "campaign_calendars",
      "to": [
        "100 - Done"
      ],
      "channel": "approved",
      "bot_name": "Calendar Done",
      "emoji": "🏁",
      "tag": [
        "client.account_manager_id"
      ],
      "action": "Nothing more to do for this month."
    }
  ]
}
